{
  "protocolVersion": 1,
  "kind": "outline.changeset",
  "idempotencyKey": "table-view-example-v1",
  "source": {
    "kind": "skill",
    "label": "Create a field-backed table on one Daily Note"
  },
  "operations": [
    {
      "op": "ensure",
      "resource": "date",
      "date": "2042-03-04",
      "bind": "day"
    },
    {
      "op": "create",
      "resource": "definition",
      "definitionType": "field",
      "name": "Model family",
      "config": {
        "fieldType": "plain"
      },
      "bind": "family"
    },
    {
      "op": "create",
      "resource": "definition",
      "definitionType": "field",
      "name": "Input price",
      "config": {
        "fieldType": "number",
        "minValue": 0
      },
      "bind": "inputPrice"
    },
    {
      "op": "create",
      "placement": {
        "kind": "last",
        "parent": {
          "binding": "day"
        }
      },
      "nodes": [
        {
          "content": {
            "text": "Model prices",
            "marks": [],
            "inlineRefs": []
          },
          "children": []
        }
      ],
      "bind": "table"
    },
    {
      "op": "create",
      "placement": {
        "kind": "last",
        "parent": {
          "binding": "table"
        }
      },
      "nodes": [
        {
          "content": {
            "text": "Model Alpha",
            "marks": [],
            "inlineRefs": []
          },
          "children": []
        }
      ],
      "bind": "alpha"
    },
    {
      "op": "create",
      "placement": {
        "kind": "last",
        "parent": {
          "binding": "table"
        }
      },
      "nodes": [
        {
          "content": {
            "text": "Model Beta",
            "marks": [],
            "inlineRefs": []
          },
          "children": []
        }
      ],
      "bind": "beta"
    },
    {
      "op": "update",
      "targets": {
        "binding": "alpha"
      },
      "changes": [
        {
          "kind": "field",
          "action": "set",
          "field": {
            "binding": "family"
          },
          "value": "Flagship"
        },
        {
          "kind": "field",
          "action": "set",
          "field": {
            "binding": "inputPrice"
          },
          "value": 2.5
        }
      ]
    },
    {
      "op": "update",
      "targets": {
        "binding": "beta"
      },
      "changes": [
        {
          "kind": "field",
          "action": "set",
          "field": {
            "binding": "family"
          },
          "value": "Efficient"
        },
        {
          "kind": "field",
          "action": "set",
          "field": {
            "binding": "inputPrice"
          },
          "value": 0.25
        }
      ]
    },
    {
      "op": "update",
      "targets": {
        "binding": "table"
      },
      "changes": [
        {
          "kind": "view",
          "property": "configuration",
          "action": "set",
          "view": {
            "mode": "table",
            "toolbar": true,
            "replace": {
              "sort": [
                {
                  "field": {
                    "binding": "inputPrice"
                  },
                  "direction": "asc"
                }
              ],
              "filters": [],
              "display": [
                {
                  "field": "sys:name",
                  "visible": true,
                  "order": 0,
                  "label": "Model"
                },
                {
                  "field": {
                    "binding": "family"
                  },
                  "visible": true,
                  "order": 1,
                  "label": "Family"
                },
                {
                  "field": {
                    "binding": "inputPrice"
                  },
                  "visible": true,
                  "order": 2,
                  "label": "Input price"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "return": [
    {
      "kind": "outline",
      "targets": {
        "binding": "table"
      },
      "depth": 2,
      "include": [
        "children",
        "fields",
        "view"
      ],
      "page": {
        "limit": 100
      },
      "format": "json"
    }
  ]
}
