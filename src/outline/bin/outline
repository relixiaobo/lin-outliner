#!/bin/sh
set -eu

launcher=$0
links=0
while [ -L "$launcher" ]; do
  links=$((links + 1))
  if [ "$links" -gt 16 ]; then
    printf '%s\n' 'outline: launcher symlink chain is too deep.' >&2
    exit 1
  fi
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$(dirname "$launcher")/$target ;;
  esac
done
bin_dir=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)
TENON_OUTLINE_LAUNCHER=$launcher
export TENON_OUTLINE_LAUNCHER

if [ -f "$bin_dir/../outline.mjs" ] && [ -f "$bin_dir/../outline-runtime.mjs" ]; then
  : "${TENON_OUTLINE_CLI_RUNTIME:=$bin_dir/../../../MacOS/Tenon}"
  : "${TENON_OUTLINE_CLI_ENTRY:=$bin_dir/../outline.mjs}"
  : "${TENON_OUTLINE_IMPORT_HELPER_ENTRY:=$bin_dir/../../built-in-skills/outline-import/scripts/outline-import.mjs}"
  : "${TENON_OUTLINE_RUNTIME_ENTRY:=$bin_dir/../outline-runtime.mjs}"
  : "${TENON_OUTLINE_RUN_AS_NODE:=1}"
  : "${TENON_OUTLINE_PACKAGED:=1}"
else
  : "${TENON_OUTLINE_CLI_RUNTIME:=bun}"
  : "${TENON_OUTLINE_CLI_ENTRY:=$bin_dir/../cli/entry.ts}"
  : "${TENON_OUTLINE_IMPORT_HELPER_ENTRY:=$bin_dir/../../../main/builtInSkills/outline-import/scripts/outline-import.ts}"
  : "${TENON_OUTLINE_RUNTIME_ENTRY:=$bin_dir/../runtime/server/entry.ts}"
fi

export TENON_OUTLINE_RUNTIME_ENTRY TENON_OUTLINE_PACKAGED TENON_OUTLINE_RUN_AS_NODE

entry=$TENON_OUTLINE_CLI_ENTRY
if [ "${1:-}" = "import-helper" ]; then
  shift
  entry=$TENON_OUTLINE_IMPORT_HELPER_ENTRY
fi

if [ ! -f "$entry" ]; then
  printf '%s\n' "outline: requested entry does not exist: $entry" >&2
  exit 1
fi

if [ "${TENON_OUTLINE_RUN_AS_NODE:-}" = "1" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$TENON_OUTLINE_CLI_RUNTIME" "$entry" "$@"
fi

exec "$TENON_OUTLINE_CLI_RUNTIME" "$entry" "$@"
