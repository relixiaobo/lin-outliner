#!/bin/sh
set -eu

launcher=$0
links=0
while [ -L "$launcher" ]; do
  links=$((links + 1))
  if [ "$links" -gt 16 ]; then
    printf '%s\n' 'delegate: launcher symlink chain is too deep.' >&2
    exit 1
  fi
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$(dirname "$launcher")/$target ;;
  esac
done
bin_dir=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd)

if [ -f "$bin_dir/../delegate.mjs" ]; then
  : "${TENON_DELEGATE_CLI_RUNTIME:=$bin_dir/../../../MacOS/Tenon}"
  : "${TENON_DELEGATE_CLI_ENTRY:=$bin_dir/../delegate.mjs}"
  : "${TENON_DELEGATE_RUN_AS_NODE:=1}"
else
  : "${TENON_DELEGATE_CLI_RUNTIME:=bun}"
  : "${TENON_DELEGATE_CLI_ENTRY:=$bin_dir/../cli/entry.ts}"
fi

if [ ! -f "$TENON_DELEGATE_CLI_ENTRY" ]; then
  printf '%s\n' "delegate: requested entry does not exist: $TENON_DELEGATE_CLI_ENTRY" >&2
  exit 1
fi

if [ "${TENON_DELEGATE_RUN_AS_NODE:-}" = "1" ]; then
  ELECTRON_RUN_AS_NODE=1 exec "$TENON_DELEGATE_CLI_RUNTIME" "$TENON_DELEGATE_CLI_ENTRY" "$@"
fi

exec "$TENON_DELEGATE_CLI_RUNTIME" "$TENON_DELEGATE_CLI_ENTRY" "$@"
