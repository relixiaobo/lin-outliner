          <div role="list" class="inset-card" aria-label="Installed skills">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">/pdf<span class="settings-chip">managed</span>
                  <span class="settings-chip">Recommended</span>
                </span>
                <span class="inset-row-sublabel">
                  <span class="settings-skill-description">Create, inspect, extract, repair, render, OCR, redact, and verify PDF artifacts.</span>
                </span>
              </span>
