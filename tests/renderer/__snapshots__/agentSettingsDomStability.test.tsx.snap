              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translation model</span>
                  <span class="inset-row-sublabel">Which model translates. Follows the Agent’s model unless you pick one.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <span class="select-popup">
                  <select class="select-popup-input" aria-label="Translation model">
                    <option selected value="">Agent model</option>
                  </select>
                  <svg data-icon="ChevronDown" class="app-icon select-popup-chevron" focusable="false" aria-hidden="true" color="currentColor" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" height="var(--icon-size-xs)" width="var(--icon-size-xs)">
                    <path stroke-linejoin="round" stroke-linecap="round" stroke="currentColor" d="M6 9L12 15L18 9" />
                  </svg>
                </span>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Saved translations</span>
                  <span class="inset-row-sublabel">Translations saved locally for webpages, captions, and EPUB books.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
        <div data-settings-anchor="websites" class="inset-group">
          <div class="inset-group-header">Websites</div>
          <div role="list" class="inset-card" aria-label="Website data">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Website data</span>
                  <span class="inset-row-sublabel">Cookies, cache, and site storage used by URL Preview.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>"
`;

