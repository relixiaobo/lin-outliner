                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-avatar has-logo">
                      <span class="settings-provider-logo">
                        <svg data-fixture-logo="anthropic" />
                      </span>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">Anthropic</span>
                  </span>
                </button>
                <div class="inset-row-trailing">
                  <div class="settings-provider-row-actions">
                    <button type="button" role="switch" aria-label="Enable or disable Anthropic" aria-checked="true">
                      <span aria-hidden="true" class="switch-mark checked">
                        <span class="switch-mark-thumb">
                        </span>
                      </span>
                    </button>
                    <button type="button" class="settings-row-menu-trigger" aria-label="Anthropic actions" aria-haspopup="menu" aria-expanded="false">
                      <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <circle r="1" cy="12" cx="12" />
                        <circle r="1" cy="12" cx="19" />
                        <circle r="1" cy="12" cx="5" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
              <div role="listitem" class="inset-row is-disabled">
                <button type="button" class="inset-row-main" aria-label="OpenAI, Disabled">
                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-avatar has-logo">
                      <span class="settings-provider-logo">
                        <svg data-fixture-logo="openai" />
                      </span>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">OpenAI</span>
                  </span>
                </button>
                <div class="inset-row-trailing">
                  <div class="settings-provider-row-actions">
                    <button type="button" role="switch" aria-label="Enable or disable OpenAI" aria-checked="false">
                      <span aria-hidden="true" class="switch-mark">
                        <span class="switch-mark-thumb">
                        </span>
                      </span>
                    </button>
                    <button type="button" class="settings-row-menu-trigger" aria-label="OpenAI actions" aria-haspopup="menu" aria-expanded="false">
                      <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <circle r="1" cy="12" cx="12" />
                        <circle r="1" cy="12" cx="19" />
                        <circle r="1" cy="12" cx="5" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="inset-group">
            <div class="inset-group-header">Add Providers</div>
            <div role="list" class="inset-card" aria-label="Providers to add">
              <div role="listitem" class="inset-row">
                <button type="button" class="inset-row-main" aria-label="Add custom provider">
                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-add-leading">
                      <svg aria-hidden="true" class="lucide lucide-plus" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                      </svg>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">Add custom provider</span>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>"
`;

