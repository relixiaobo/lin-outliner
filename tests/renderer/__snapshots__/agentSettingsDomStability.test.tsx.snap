          <span class="settings-nav-copy">
            <span class="settings-nav-label">Agent</span>
          </span>
        </button>
        <button type="button" class="settings-nav-item is-active" aria-current="page">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-database" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <ellipse ry="3" rx="9" cy="5" cx="12" />
              <path d="M3 5V19A9 3 0 0 0 21 19V5" />
              <path d="M3 12A9 3 0 0 0 21 12" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Preview</span>
          </span>
        </button>
      </nav>
    </aside>
    <div class="settings-content">
      <section aria-label="Preview" class="agent-settings-section">
        <div data-settings-anchor="translation" class="inset-group">
          <div class="inset-group-header">Translation</div>
          <div role="list" class="inset-card" aria-label="Translation preferences">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translate to</span>
                  <span class="inset-row-sublabel">The language webpages, captions, and books are translated into.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <span class="select-popup">
                  <select class="select-popup-input" aria-label="Translate to">
                    <option selected value="en">English</option>
                    <option value="zh-Hans">简体中文</option>
                    <option value="zh-Hant">繁體中文</option>
                    <option value="es">Español</option>
                    <option value="ja">日本語</option>
                    <option value="ko">한국어</option>
                    <option value="fr">Français</option>
                    <option value="de">Deutsch</option>
                    <option value="pt">Português</option>
                    <option value="it">Italiano</option>
                    <option value="ru">Русский</option>
                    <option value="ar">العربية</option>
                    <option value="hi">हिन्दी</option>
                    <option value="bn">বাংলা</option>
                    <option value="ur">اردو</option>
                    <option value="id">Bahasa Indonesia</option>
                    <option value="ms">Bahasa Melayu</option>
                    <option value="vi">Tiếng Việt</option>
                    <option value="th">ไทย</option>
                    <option value="tr">Türkçe</option>
                    <option value="pl">Polski</option>
                    <option value="nl">Nederlands</option>
                    <option value="uk">Українська</option>
                    <option value="fa">فارسی</option>
                    <option value="he">עברית</option>
                    <option value="sv">Svenska</option>
                    <option value="nb">Norsk bokmål</option>
                    <option value="da">Dansk</option>
                    <option value="fi">Suomi</option>
                    <option value="el">Ελληνικά</option>
                    <option value="cs">Čeština</option>
                    <option value="ro">Română</option>
                    <option value="hu">Magyar</option>
                    <option value="sk">Slovenčina</option>
                    <option value="bg">Български</option>
                    <option value="hr">Hrvatski</option>
                    <option value="sr">Српски</option>
                    <option value="sl">Slovenščina</option>
                    <option value="lt">Lietuvių</option>
                    <option value="lv">Latviešu</option>
                    <option value="et">Eesti</option>
                    <option value="ca">Català</option>
                    <option value="fil">Filipino</option>
                    <option value="sw">Kiswahili</option>
                    <option value="ta">தமிழ்</option>
                    <option value="te">తెలుగు</option>
                    <option value="mr">मराठी</option>
                    <option value="gu">ગુજરાતી</option>
                    <option value="kn">ಕನ್ನಡ</option>
                    <option value="ml">മലയാളം</option>
                    <option value="pa">ਪੰਜਾਬੀ</option>
                    <option value="ne">नेपाली</option>
                    <option value="si">සිංහල</option>
                    <option value="my">မြန်မာ</option>
                  </select>
                  <svg aria-hidden="true" class="lucide lucide-chevron-down select-popup-chevron" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="12" width="12" xmlns="http://www.w3.org/2000/svg">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translate webpages automatically</span>
                  <span class="inset-row-sublabel">Translate every webpage preview as it opens, without asking.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" role="switch" aria-label="Translate webpages automatically" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translate books automatically</span>
                  <span class="inset-row-sublabel">Translate EPUB books as you read them. Separate from webpages, because a book is sent to a provider a chapter at a time.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" role="switch" aria-label="Translate books automatically" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translation model</span>
                  <span class="inset-row-sublabel">Which model translates. Follows the Agent’s model unless you pick one.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <span class="select-popup">
                  <select class="select-popup-input" aria-label="Translation model">
                    <option selected value="">Agent model</option>
                  </select>
                  <svg aria-hidden="true" class="lucide lucide-chevron-down select-popup-chevron" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="12" width="12" xmlns="http://www.w3.org/2000/svg">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Saved translations</span>
                  <span class="inset-row-sublabel">Translations saved locally for webpages, captions, and EPUB books.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
        <div data-settings-anchor="websites" class="inset-group">
          <div class="inset-group-header">Websites</div>
          <div role="list" class="inset-card" aria-label="Website data">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Website data</span>
                  <span class="inset-row-sublabel">Cookies, cache, and site storage used by URL Preview.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>"
`;

exports[`settings page DOM renders the services page byte-stably 1`] = `
"<main aria-labelledby="settings-page-title" class="settings-window">
  <div class="settings-drag-region">
    <div class="settings-toolbar">
      <div class="settings-history-nav">
        <button type="button" title="Back" class="icon-button icon-button-chrome rail-toggle" aria-label="Back" disabled>
          <svg aria-hidden="true" class="lucide lucide-chevron-left" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.7" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <span aria-hidden="true" class="settings-history-divider">
        </span>
        <button type="button" title="Forward" class="icon-button icon-button-chrome rail-toggle" aria-label="Forward" disabled>
          <svg aria-hidden="true" class="lucide lucide-chevron-right" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.7" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
      <h1 id="settings-page-title" class="settings-toolbar-title">Model services</h1>
    </div>
  </div>
  <div class="settings-layout">
    <aside class="settings-rail">
      <h2 class="settings-rail-title">Settings</h2>
      <nav aria-label="Settings categories" class="settings-nav">
        <button type="button" class="settings-nav-item">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-settings" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
              <circle r="3" cy="12" cx="12" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">General</span>
          </span>
          <span class="settings-status-dot is-hidden" aria-hidden="true">
          </span>
        </button>
        <button type="button" class="settings-nav-item is-active" aria-current="page">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-graduation-cap" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
              <path d="M22 10v6" />
              <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Agent</span>
          </span>
        </button>
        <button type="button" class="settings-nav-item">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-database" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <ellipse ry="3" rx="9" cy="5" cx="12" />
              <path d="M3 5V19A9 3 0 0 0 21 19V5" />
              <path d="M3 12A9 3 0 0 0 21 12" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Preview</span>
          </span>
        </button>
      </nav>
    </aside>
    <div class="settings-content">
      <section aria-label="Model services" class="agent-settings-section settings-providers-section">
        <div class="settings-provider-groups">
          <div class="inset-group">
            <div class="inset-group-header">Image generation</div>
            <div role="list" class="inset-card" aria-label="Image generation settings">
              <div role="listitem" class="inset-row">
                <div class="inset-row-main is-static">
                  <span class="inset-row-text is-wrap">
                    <span class="inset-row-label">Default model</span>
                    <span class="inset-row-sublabel">Used when generate_image does not name a model.</span>
                  </span>
                </div>
                <div class="inset-row-trailing">
                  <span class="select-popup">
                    <select class="select-popup-input" aria-label="Default model">
                      <option selected value="">Auto</option>
                    </select>
                    <svg aria-hidden="true" class="lucide lucide-chevron-down select-popup-chevron" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="12" width="12" xmlns="http://www.w3.org/2000/svg">
                      <path d="m6 9 6 6 6-6" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          </div>
          <div class="inset-group">
            <div class="inset-group-header">Configured</div>
            <div role="list" class="inset-card" aria-label="Configured providers">
              <div role="listitem" class="inset-row">
                <button type="button" class="inset-row-main" aria-label="Anthropic, Needs key">
                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-avatar has-logo">
                      <span class="settings-provider-logo">
                        <svg data-fixture-logo="anthropic" />
                      </span>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">Anthropic</span>
                    <span class="inset-row-sublabel">Needs key</span>
                  </span>
                </button>
                <div class="inset-row-trailing">
                  <div class="settings-provider-row-actions">
                    <button type="button" role="switch" aria-label="Enable or disable Anthropic" aria-checked="true">
                      <span aria-hidden="true" class="switch-mark checked">
                        <span class="switch-mark-thumb">
                        </span>
                      </span>
                    </button>
                    <button type="button" class="settings-row-menu-trigger" aria-label="Anthropic actions" aria-haspopup="menu" aria-expanded="false">
                      <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <circle r="1" cy="12" cx="12" />
                        <circle r="1" cy="12" cx="19" />
                        <circle r="1" cy="12" cx="5" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
              <div role="listitem" class="inset-row is-disabled">
                <button type="button" class="inset-row-main" aria-label="OpenAI, Disabled">
                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-avatar has-logo">
                      <span class="settings-provider-logo">
                        <svg data-fixture-logo="openai" />
                      </span>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">OpenAI</span>
                    <span class="inset-row-sublabel">Disabled</span>
                  </span>
                </button>
                <div class="inset-row-trailing">
                  <div class="settings-provider-row-actions">
                    <button type="button" role="switch" aria-label="Enable or disable OpenAI" aria-checked="false">
                      <span aria-hidden="true" class="switch-mark">
                        <span class="switch-mark-thumb">
                        </span>
                      </span>
                    </button>
                    <button type="button" class="settings-row-menu-trigger" aria-label="OpenAI actions" aria-haspopup="menu" aria-expanded="false">
                      <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <circle r="1" cy="12" cx="12" />
                        <circle r="1" cy="12" cx="19" />
                        <circle r="1" cy="12" cx="5" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="inset-group">
            <div class="inset-group-header">Add providers</div>
            <div role="list" class="inset-card" aria-label="Providers to add">
              <div role="listitem" class="inset-row">
                <button type="button" class="inset-row-main" aria-label="Add custom provider">
                  <span class="inset-row-leading">
                    <span aria-hidden="true" class="settings-provider-add-leading">
                      <svg aria-hidden="true" class="lucide lucide-plus" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                        <path d="M5 12h14" />
                        <path d="M12 5v14" />
                      </svg>
                    </span>
                  </span>
                  <span class="inset-row-text">
                    <span class="inset-row-label">Add custom provider</span>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>"
`;

