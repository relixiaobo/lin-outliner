                <button type="button" role="switch" aria-label="Translate webpages automatically" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Translate books automatically</span>
                  <span class="inset-row-sublabel">Translate EPUB books as you read them. Separate from webpages, because a book is sent to a provider a chapter at a time.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" role="switch" aria-label="Translate books automatically" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
