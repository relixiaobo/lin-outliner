    <div class="settings-content">
      <section aria-label="Providers" class="agent-settings-section settings-providers-section">
        <div class="settings-provider-groups">
          <div class="inset-group">
            <div class="inset-group-header">Image generation</div>
            <div role="list" class="inset-card" aria-label="Image generation settings">
              <div role="listitem" class="inset-row">
                <div class="inset-row-main is-static">
                  <span class="inset-row-text is-wrap">
                    <span class="inset-row-label">Default model</span>
                    <span class="inset-row-sublabel">Used when generate_image does not name a model.</span>
                  </span>
                </div>
                <div class="inset-row-trailing">
                  <span class="select-popup settings-image-model-select">
                    <select class="select-popup-input" aria-label="Default model">
                      <option selected value="">Auto</option>
                    </select>
                    <svg aria-hidden="true" class="lucide lucide-chevron-down select-popup-chevron" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="12" width="12" xmlns="http://www.w3.org/2000/svg">
