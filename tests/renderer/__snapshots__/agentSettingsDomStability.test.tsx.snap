"<main aria-labelledby="settings-page-title" class="settings-window">
  <div class="settings-drag-region">
    <div class="settings-toolbar">
      <div class="settings-history-nav">
        <button type="button" title="Back" class="icon-button icon-button-chrome rail-toggle" aria-label="Back" disabled>
          <svg aria-hidden="true" class="lucide lucide-chevron-left" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.7" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg">
            <path d="m15 18-6-6 6-6" />
          </svg>
        </button>
        <span aria-hidden="true" class="settings-history-divider">
        </span>
        <button type="button" title="Forward" class="icon-button icon-button-chrome rail-toggle" aria-label="Forward" disabled>
          <svg aria-hidden="true" class="lucide lucide-chevron-right" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.7" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="16" width="16" xmlns="http://www.w3.org/2000/svg">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </button>
      </div>
      <h1 id="settings-page-title" class="settings-toolbar-title">General</h1>
    </div>
  </div>
  <div class="settings-layout">
    <aside class="settings-rail">
      <h2 class="settings-rail-title">Settings</h2>
      <nav aria-label="Settings categories" class="settings-nav">
        <button type="button" class="settings-nav-item is-active" aria-current="page">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-settings" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
              <circle r="3" cy="12" cx="12" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">General</span>
          </span>
        </button>
        <button type="button" class="settings-nav-item">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-database" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <ellipse ry="3" rx="9" cy="5" cx="12" />
              <path d="M3 5V19A9 3 0 0 0 21 19V5" />
              <path d="M3 12A9 3 0 0 0 21 12" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Providers</span>
          </span>
        </button>
        <button type="button" class="settings-nav-item">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-key-round" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M2.586 17.414A2 2 0 0 0 2 18.828V21a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h1a1 1 0 0 0 1-1v-1a1 1 0 0 1 1-1h.172a2 2 0 0 0 1.414-.586l.814-.814a6.5 6.5 0 1 0-4-4z" />
              <circle fill="currentColor" r=".5" cy="7.5" cx="16.5" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Security</span>
          </span>
        </button>
        <button type="button" class="settings-nav-item">
          <span aria-hidden="true" class="settings-nav-icon">
            <svg aria-hidden="true" class="lucide lucide-graduation-cap" stroke-linejoin="round" stroke-linecap="round" stroke-width="1.75" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z" />
              <path d="M22 10v6" />
              <path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5" />
            </svg>
          </span>
          <span class="settings-nav-copy">
            <span class="settings-nav-label">Skills</span>
          </span>
        </button>
      </nav>
    </aside>
    <div class="settings-content">
      <section aria-label="General" class="agent-settings-section settings-general-section">
        <div class="inset-group">
          <div class="inset-group-header">Appearance</div>
          <div role="list" class="inset-card" aria-label="Appearance">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Theme</span>
                  <span class="inset-row-sublabel">Match the system appearance, or always use light or dark.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <div role="radiogroup" class="segmented-control" aria-label="Theme">
                  <button type="button" tabindex="0" role="radio" class="segmented-control-option is-selected" aria-checked="true">System</button>
                  <button type="button" tabindex="-1" role="radio" class="segmented-control-option" aria-checked="false">Light</button>
                  <button type="button" tabindex="-1" role="radio" class="segmented-control-option" aria-checked="false">Dark</button>
                </div>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Language</span>
                  <span class="inset-row-sublabel">Choose the display language for menus and the interface.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <span class="select-popup">
                  <select class="select-popup-input" aria-label="Language">
                    <option selected value="en">English</option>
                    <option value="zh-Hans">简体中文</option>
                  </select>
                  <svg aria-hidden="true" class="lucide lucide-chevron-down select-popup-chevron" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="12" width="12" xmlns="http://www.w3.org/2000/svg">
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
        <div class="inset-group">
          <div class="inset-group-header">Notifications</div>
          <div role="list" class="inset-card" aria-label="Notifications">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">System notifications</span>
                  <span class="inset-row-sublabel">Show a system notification when a background Turn finishes or needs input while the app is in the background. Off by default.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" role="switch" aria-label="System notifications" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
            </div>
          </div>
        </div>
        <div class="inset-group">
          <div class="inset-group-header">Memory</div>
          <div role="list" class="inset-card" aria-label="Memory">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Use Memory</span>
                  <span class="inset-row-sublabel">Use and update durable Memory stored as editable Nodes in Daily Notes.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" role="switch" aria-label="Use Memory" aria-checked="false">
                  <span aria-hidden="true" class="switch-mark">
                    <span class="switch-mark-thumb">
                    </span>
                  </span>
                </button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Timeline Memory</span>
                  <span class="inset-row-sublabel">Ready. New durable Memory is extracted after eligible Threads become idle.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Open Memory</button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Reset Memory</span>
                  <span class="inset-row-sublabel">Permanently delete canonical Memory containers and every descendant inside them. Notes outside those containers and stray tagged Nodes are preserved.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-danger button-md">Reset Memory</button>
              </div>
            </div>
          </div>
        </div>
        <div class="inset-group">
          <div class="inset-group-header">Websites</div>
          <div role="list" class="inset-card" aria-label="Websites">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Website data</span>
                  <span class="inset-row-sublabel">Cookies, cache, and site storage used by URL Preview.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
        <div class="inset-group">
          <div class="inset-group-header">Translation Data</div>
          <div role="list" class="inset-card" aria-label="Translation Data">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Saved translations</span>
                  <span class="inset-row-sublabel">Translations saved locally for webpages, captions, and EPUB books.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Clear…</button>
              </div>
            </div>
          </div>
        </div>
        <div class="inset-group">
          <div class="inset-group-header">Diagnostics</div>
          <div role="list" class="inset-card" aria-label="Diagnostics">
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Diagnostics log</span>
                  <span class="inset-row-sublabel">Reveal the local structured error log in Finder.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Reveal</button>
              </div>
            </div>
            <div role="listitem" class="inset-row">
              <div class="inset-row-main is-static">
                <span class="inset-row-text is-wrap">
                  <span class="inset-row-label">Diagnostics export</span>
                  <span class="inset-row-sublabel">Save recent diagnostics and minimal environment details as JSON.</span>
                </span>
              </div>
              <div class="inset-row-trailing">
                <button type="button" class="button button-secondary button-md">Export…</button>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>"
`;

