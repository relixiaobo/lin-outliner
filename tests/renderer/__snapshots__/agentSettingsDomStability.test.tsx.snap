              <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
                <circle r="1" cy="12" cx="12" />
                <circle r="1" cy="12" cx="19" />
                <circle r="1" cy="12" cx="5" />
              </svg>
            </button>
            <button type="button" role="switch" aria-label="Toggle project-lint" aria-checked="false">
              <span aria-hidden="true" class="switch-mark">
                <span class="switch-mark-thumb">
                </span>
              </span>
            </button>
          </div>
        </div>
        <div role="listitem" class="inset-row">
          <div class="inset-row-main is-static">
            <span class="inset-row-text is-wrap">
              <span class="inset-row-label">/project-undoable<span class="settings-chip">project</span>
            </span>
            <span class="inset-row-sublabel">
              <span class="settings-skill-description">Fixture skill project-undoable.</span>
            </span>
          </span>
        </div>
        <div class="inset-row-trailing">
          <button type="button" class="settings-row-menu-trigger" aria-label="project-undoable actions" aria-haspopup="menu" aria-expanded="false">
            <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
              <circle r="1" cy="12" cx="12" />
              <circle r="1" cy="12" cx="19" />
              <circle r="1" cy="12" cx="5" />
            </svg>
          </button>
          <button type="button" role="switch" aria-label="Toggle project-undoable" aria-checked="true">
            <span aria-hidden="true" class="switch-mark checked">
              <span class="switch-mark-thumb">
              </span>
            </span>
          </button>
        </div>
      </div>
      <div role="listitem" class="inset-row">
        <div class="inset-row-main is-static">
          <span class="inset-row-text is-wrap">
            <span class="inset-row-label">/skillify<span class="settings-chip">built-in</span>
          </span>
          <span class="inset-row-sublabel">
            <span class="settings-skill-description">Fixture skill skillify.</span>
          </span>
        </span>
      </div>
      <div class="inset-row-trailing">
        <button type="button" class="settings-row-menu-trigger" aria-label="skillify actions" aria-haspopup="menu" aria-expanded="false">
          <svg aria-hidden="true" class="lucide lucide-ellipsis" stroke-linejoin="round" stroke-linecap="round" stroke-width="2" stroke="currentColor" fill="none" viewBox="0 0 24 24" height="14" width="14" xmlns="http://www.w3.org/2000/svg">
            <circle r="1" cy="12" cx="12" />
